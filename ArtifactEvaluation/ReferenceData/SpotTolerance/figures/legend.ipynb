    "# Legend for Bar Plots (Throughput/Cost Analysis)\n",
    "fig, ax = plt.subplots(figsize=(12, 1.5))\n",
    "ax.axis('off')\n",
    "\n",
    "# Define colors - these match the bar plot order\n",
    "colors = ['#808080', '#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']  # Gray: On-demand, Blue: ShuntServe, Orange: Concurrent, Green: Request, Red: No Handle\n",
    "labels = ['On-demand Only', 'ShuntServe', 'Concurrent Initialization', 'Request Migration', 'No Handle']\n",
    "\n",
    "# Create legend elements (rectangles without patterns)\n",
    "legend_elements = [mpatches.Rectangle((0, 0), 1, 1, \n",
    "                                      facecolor=color, \n",
    "                                      edgecolor='black', \n",
    "                                      linewidth=1.5, \n",
    "                                      alpha=0.7,\n",
    "                                      label=label) \n",
    "                   for color, label in zip(colors, labels)]\n",
    "\n",
    "# Create legend\n",
    "legend = ax.legend(handles=legend_elements, loc='center', \n",
    "                   fontsize=18, framealpha=0.9, ncol=5,\n",
    "                   columnspacing=1.5, handlelength=2.5)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('legend_bar_plot.pdf', dpi=300, bbox_inches='tight', transparent=True)\n",
    "plt.show()\n",
    "print(\"Saved: legend_bar_plot.pdf\")"
   ]
