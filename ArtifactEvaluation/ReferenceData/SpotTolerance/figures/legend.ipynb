    "# Legend for Line Plots (RPS/Latency time series)\n",
    "# Matches the default matplotlib color cycle order as used in the plot functions\n",
    "fig, ax = plt.subplots(figsize=(14, 1))\n",
    "ax.axis('off')\n",
    "\n",
    "# Colors match the order in which approaches are plotted:\n",
    "# On-demand (gray), ShuntServe (blue), Concurrent Init (orange), Request Migration (green), No Handle (red), Avg (black dashed)\n",
    "colors = ['#808080', '#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', 'black']\n",
    "labels = ['On-demand Only', 'ShuntServe', 'Concurrent Initialization', 'Request Migration', 'No Handle', 'Average']\n",
    "linestyles = ['-', '-', '-', '-', '-', '--']\n",
    "\n",
    "# Create legend elements\n",
    "legend_elements = [Line2D([0], [0], color=color, linewidth=3, linestyle=linestyle, label=label) \n",
    "                   for color, linestyle, label in zip(colors, linestyles, labels)]\n",
    "\n",
    "# Create legend\n",
    "legend = ax.legend(handles=legend_elements, loc='center', \n",
    "                   fontsize=18, ncol=6,\n",
    "                   columnspacing=1.5, handlelength=2.5, edgecolor='black')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('preemption_tolerance_legend.pdf', dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Saved: preemption_tolerance_legend.pdf\")"
   ]
