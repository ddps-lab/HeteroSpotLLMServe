.vscode**
**__pycache__**
.basedpyright
GlobalServer/logs/**
TensorStore/models
.DS_Store
!SpotAvailabilityTrace

**/*.so
**/.terraform/**
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.lock.info
**/terraform.tfstate.backup
**/terraform.tfstate.backup.lock.info

submodules/vLLM/vllm.egg-info/
submodules/vLLM/vllm/_version.py
submodules/vLLM/vllm/vllm_flash_attn/

# Generated figures (auto-generated from data + code)
# Keep notebook sources, py scripts, and README indexes; ignore only rendered outputs.
**/figures/*.pdf
**/figures/*.png
**/figures/*.svg
**/figures/*.jpg
**/figures/*.jpeg

# PerformanceEstimation: generated estimation JSONs and benchmark p files
# Regenerate with: estimate.py and generate_p_files.py
ArtifactEvaluation/PerformanceEstimation/*/in*-out*/

# TRT-LLM: datasets, predictions, logs (engines/ckpt/models on ephemeral storage, not in workspace)
ArtifactEvaluation/PerformanceEstimation/trtllm/*/in*-out*/datasets/
ArtifactEvaluation/PerformanceEstimation/trtllm/*/in*-out*/predicted/
ArtifactEvaluation/PerformanceEstimation/trtllm/*/in*-out*/measured/*.log

# ReferenceData: predicted/estimated files are generated (not tracked)
ArtifactEvaluation/ReferenceData/PerformanceEstimation/trtllm/*/in*-out*/predicted/
ArtifactEvaluation/ReferenceData/PerformanceEstimation/vllm/*/in*-out*/estimated/

# ModelPlacement: optimizer results are generated by optimizer/*.py
ArtifactEvaluation/ModelPlacement/optimizer/results/*/estimated/
ArtifactEvaluation/ModelPlacement/optimizer/results/*/measured/

./ArtifactEvaluation/Datasets/*.png
./ArtifactEvaluation/Datasets/*.pdf

# Trace: runtime experiment logs
ArtifactEvaluation/Trace/

